
{
  "name": "tflm",
  "version": "1.0.0",
  "build": {
    "includeDir": ".",
    "srcDir": ".",
    "srcFilter": [
      "+<tensorflow/lite/**/*.c>",
      "+<tensorflow/lite/**/*.cc>",

      "-<tensorflow/lite/micro/kernels/**>",
      "+<tensorflow/lite/micro/kernels/depthwise_conv.cc>",
      "+<tensorflow/lite/micro/kernels/depthwise_conv_common.cc>",
      "+<tensorflow/lite/micro/kernels/fully_connected.cc>",
      "+<tensorflow/lite/micro/kernels/fully_connected_common.cc>",
      "+<tensorflow/lite/micro/kernels/reshape.cc>",
      "+<tensorflow/lite/micro/kernels/reshape_common.cc>",
      "+<tensorflow/lite/micro/kernels/softmax.cc>",
      "+<tensorflow/lite/micro/kernels/softmax_common.cc>",
      "+<tensorflow/lite/micro/kernels/kernel_util.cc>",
      "+<tensorflow/lite/micro/kernels/internal/**>",

      "-<tensorflow/lite/**/*test*>",
      "-<tensorflow/lite/**/*benchmark*>",
      "-<tensorflow/lite/**/examples/**>",
      "-<signal/**>",
      "-<examples/**>"
    ],
    "flags": [
      "-std=gnu++17"
    ]
  }
}
